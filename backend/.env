# Database
DATABASE_URL=sqlite:///./ai_navigator.db

# JWT Authentication
SECRET_KEY=change_this_to_a_random_string_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI API (for intent detection and chat proxy)
OPENAI_API_KEY=sk-your-openai-api-key-here

# App Settings
APP_NAME=AI Navigator
APP_VERSION=1.0.0
DEBUG=True
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000